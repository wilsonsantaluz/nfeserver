procedure TSefazCore.corrigirCodigoNumerico(var FACBrNFe: TACBrNFe);
begin
  if FACBrNFe.NotasFiscais[0].nfe.Ide.cNF = FACBrNFe.NotasFiscais[0].nfe.Ide.nNF
  then
  begin
    FACBrNFe.NotasFiscais[0].nfe.Ide.cNF := GeraNumeroValidoCNf(FACBrNFe);
  end;
end;

