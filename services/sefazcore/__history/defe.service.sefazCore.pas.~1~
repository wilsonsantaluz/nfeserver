function TSefazCore.cancelar(var Facbr: TACBrNFe): string;

var

  Justificativa: string;
  str: string;
  ochave: string;
begin
  FcStat := 5001;
  codigoErro := 5001;
  result := '';
  try
    FnfceCancelada := false;
    Justificativa := 'ERRO NA GERAÇÃO DO CUPON';
    // 1- PRODUCAO
    // 2-HOMOLOGACAO
    if Fdt_vd = '' then
      Fdt_vd := Datetostr(date);
    if (Facbr.NotasFiscais.Count > 0) then
    begin

      TAcbrConfig.SetAcbrObj(Facbr, FCnpjFilial);
      try
        ochave := Facbr.NotasFiscais[0].nfe.procNFe.chNFe;
      except

      end;

      Facbr.Configuracoes.Geral.ModeloDF := moNFCe;
      Facbr.Configuracoes.WebServices.Ambiente := taProducao;
      // Facbr.Configuracoes.WebServices.Ambiente := taHomologacao;
      Facbr.Configuracoes.WebServices.UF := FufFilial;
      Facbr.EventoNFe.Evento.Clear;
      with Facbr.EventoNFe.Evento.Add do
      begin
        if ochave <> '' then
          infEvento.chNFe := ochave
        else
          infEvento.chNFe := FchaveNfe;
        infEvento.cnpj := FCnpjFilial;
        if Facbr.NotasFiscais.Count > 0 then
          infEvento.dhEvento := Facbr.NotasFiscais[0].nfe.Ide.dEmi
        Else
          infEvento.dhEvento := now;
        infEvento.tpEvento := teCancelamento;
        infEvento.detEvento.xJust := Justificativa;
        infEvento.detEvento.nProt := FnrProtocolo;
      end;
      try
        Facbr.EnviarEvento(1);
      except
        on e: EXCEPTION do
        begin
          Fmotivo := e.Message;
        end;
      end;
      if Facbr.WebServices.EnvEvento.EventoRetorno.retEvento.Count > 0 then
      begin

        FcStat := Facbr.WebServices.EnvEvento.EventoRetorno.retEvento.Items[0]
          .RetInfEvento.cstat;
        Fmotivo := Facbr.WebServices.EnvEvento.EventoRetorno.retEvento.Items[0]
          .RetInfEvento.xmotivo;
      end;

      // SE DER ERRO DE DATA TENTA NOVAMENTE
      If (FcStat = 577) then
      begin
        try
          Facbr.EventoNFe.Evento[0].infEvento.dhEvento := now;
          Facbr.EnviarEvento(1);
        except
          on e: EXCEPTION do
          begin
            Fmotivo := e.Message;
          end;
        end;
        FcStat := Facbr.WebServices.EnvEvento.EventoRetorno.retEvento.Items[0]
          .RetInfEvento.cstat;
        Fmotivo := Facbr.WebServices.EnvEvento.EventoRetorno.retEvento.Items[0]
          .RetInfEvento.xmotivo;

      end;
      If (FcStat = 135) or (FcStat = 155) then
      begin
        FnfceCancelada := true;
        result := '<nfeCanc>' + Facbr.WebServices.EnvEvento.DadosMsg + #13#10 +
          Facbr.WebServices.EnvEvento.RetWS + '</nfeCanc>';
        FAutorizado := true;
        if Facbr.WebServices.EnvEvento.EventoRetorno.retEvento.Items[0]
          .RetInfEvento.nProt = '' Then
          Facbr.WebServices.EnvEvento.EventoRetorno.retEvento.Items[0]
            .RetInfEvento.nProt := FormatDateTime('yymmddhhmmsszz', now);

      end;
    end;
  except
    on e: EXCEPTION do
    begin
      mydebug('[CANELAMENTO] ' + e.Message);
      mensagemErro := e.Message;
    end;
  end;
end;

procedure TSefazCore.checarTagsProtocolo(var FACBrNFe: TACBrNFe);
begin
  if FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.dhRecbto < 100 then
    FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.dhRecbto :=
      FACBrNFe.NotasFiscais.Items[0].nfe.Ide.dEmi + FACBrNFe.NotasFiscais.Items
      [0].nfe.Ide.hSaiEnt;

  if FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.verAplic = '' then
    FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.verAplic := 'SV_3_1';

  if FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.cstat = 0 then
  Begin
    FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.cstat := 100;
  End;
  if FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.xmotivo = '' then
  Begin
    FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.xmotivo :=
      'Autorizado o uso  da nfe';
  end;
end;

procedure TSefazCore.regerarXMLnota(var FACBrNFe: TACBrNFe);
