function TSefazCore.GeraNumeroValidoCNf(var FACBrNFe: TACBrNFe): Integer;

var
  data: string;
  diaMes: string;
  nrSugerida: Integer;
  function padLeftzero(value: string; op: Integer): string;
  begin
    result := Copy(value, 0, op);
    while Length(result) < op do
    begin
      result := '0' + result;
    end;
  end;
  function ehvavalido(value: Integer): Boolean;
  begin
    result := true;
    case value of
      0:
        result := false;
      11111111:
        result := false;
      22222222:
        result := false;
      33333333:
        result := false;
      44444444:
        result := false;
      55555555:
        result := false;
      66666666:
        result := false;
      77777777:
        result := false;
      88888888:
        result := false;
      99999999:
        result := false;
      12345678:
        result := false;
    end;
  end;

begin
  diaMes := FormatDateTime('ddMM', FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi);
  if Fcd_nf = '' then
  begin
    Fcd_nf := inttostr(FACBrNFe.NotasFiscais[0].nfe.Ide.nNF);
  end;
  nrSugerida := strtoint(padLeftzero((diaMes + Fcd_filial + Fcd_nf), 8));
  while not ehvavalido(nrSugerida) do
    nrSugerida := nrSugerida + 1;

  result := nrSugerida;
end;

