function TSefazCore.inutilizar(Var Facbr: TACBrNFe): string;
var
  Ano: string;
  Justificativa: string;
begin
  FcStat := 5001;
  Finutilizado := false;
  codigoErro := 5001;
  try
    if Fserie = '' then
      raise EXCEPTION.create('SERIE NÃO INFORMADA !');
    Justificativa := 'ERRO NA GERAÇÃO DO CUPON';
    // 1- PRODUCAO
    // 2-HOMOLOGACAO
    if Fdt_vd = '' then
      Fdt_vd := Datetostr(date);
    TAcbrConfig.SetAcbrObj(Facbr, FCnpjFilial);
    Ano := FormatDateTime('YYYY', strtodate(Fdt_vd));
    Facbr.Configuracoes.Geral.ModeloDF := moNFCe;
    Facbr.Configuracoes.WebServices.Ambiente := taProducao;
    // Facbr.Configuracoes.WebServices.Ambiente := taHomologacao;
    Facbr.Configuracoes.WebServices.UF := FufFilial;
    try
      Facbr.WebServices.Inutiliza(FCnpjFilial, Justificativa, strtoint(Ano), 65,
        strtoint(Fserie), strtoint(Fnr_ecf), strtoint(Fnr_ecf));
    except
      on e: EXCEPTION do
      begin
        mensagemErro := e.Message;
        mydebug('[SEFAZCORE 1736] ' + e.Message);
      end;
    end;
    FcStat := Facbr.WebServices.Inutilizacao.cstat;
    Fmotivo := Facbr.WebServices.Inutilizacao.xmotivo;
    result := Facbr.WebServices.Inutilizacao.RetornoWS;
    If (FcStat = 563) then
    begin

      Finutilizado := true;
      Fmotivo := 'Inutilização de numeração homologado';
      if Facbr.WebServices.Inutilizacao.Protocolo = '' then
        Facbr.WebServices.Inutilizacao.Protocolo :=
          FormatDateTime('yymmddhhmmsszz', now);

      result := Facbr.WebServices.Inutilizacao.XML_ProcInutNFe;
    end
    else If FcStat = 102 then
    begin

      Finutilizado := true;
      Fmotivo := 'Inutilização de numeração homologado';
      if Facbr.WebServices.Inutilizacao.Protocolo = '' then
        Facbr.WebServices.Inutilizacao.Protocolo :=
          FormatDateTime('yymmddhhmmsszz', now);

      result := Facbr.WebServices.Inutilizacao.XML_ProcInutNFe;
    end
    else
    begin
      if Facbr.WebServices.Inutilizacao.cstat > 0 then
        codigoErro := Facbr.WebServices.Inutilizacao.cstat;
      if Facbr.WebServices.Inutilizacao.msg <> '' then
        mensagemErro := Facbr.WebServices.Inutilizacao.msg;
    end;
  except
    on e: EXCEPTION do
    begin
      mydebug('[INUTILIZACAO] ' + e.Message);
      mensagemErro := e.Message;
    end;
  end;
end;

{ ----------------------------------------------------------------------------- }
function TSefazCore.cuponJaValidado(var FACBrNFe: TACBrNFe): Boolean;
var

  novachave: string;
  omsg: string;
  chavefoiAlterada: Boolean;

  ocdNf: string;
  tpEmiss: Integer;

begin
  result := false;
  try
    VInicio := Time;
    novachave := Sonumeros(FACBrNFe.NotasFiscais[0].nfe.infNFe.ID);
    mydebug('      [CONSULTA PREVALIDA]---> CONSULTANDO CHAVE DE ACESSO ' +
      novachave);
    omsg := consultachave(novachave);
    setIndicadores;
    mydebug('      [CONSULTA PREVALIDA]---> RESULTADO STEP1  : ' + omsg);
    // TRATAR  PROBLEMAS DE CODIGO NUMERICO GERADO DIFERENTE PELO PPDV
    if Pos('rico da NF-e', omsg) > 0 then
    begin
      chavefoiAlterada := true;
      // muda ate data por que esta pora de xml cagado e gerado todo fodido

      novachave := Copy(omsg, Pos('rico da NF-e', omsg) + 12, 60);
      if Pos('[', novachave) > 0 then
        novachave := Sonumeros(Copy(omsg, Pos('[', omsg) + 1, 44));

      omsg := consultachave(novachave);
      mydebug('      [CONSULTA PREVALIDA]---> RESULTADO STEP2  : ' + omsg);
      Fautorizacao := FdadosConsulta.nProt;
      if Fautorizacao <> '' then
        FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi := FdadosConsulta.data;

    end;

    Fautorizacao := '';
    Fautorizacao := FdadosConsulta.nProt;
    if Fautorizacao = '' then
    begin

      novachave := GerarChaveAcesso(FACBrNFe.NotasFiscais[0].nfe.Ide.cUF,
        FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi,
        FACBrNFe.NotasFiscais[0].nfe.Emit.CNPJCPF,
        FACBrNFe.NotasFiscais[0].nfe.Ide.serie,
        FACBrNFe.NotasFiscais[0].nfe.Ide.nNF, 1,
        FACBrNFe.NotasFiscais[0].nfe.Ide.cNF, 65);
      mydebug('      [CONSULTA PREVALIDA]---> CHAVE NORMAL  : ' + novachave);
      omsg := consultachave(novachave);
      mydebug('      [CONSULTA PREVALIDA]---> RESULTADO STEP3  : ' + omsg);
      Fautorizacao := FdadosConsulta.nProt;

    end;

    if Fautorizacao <> '' then
    begin
      // TRATAR SE E O PROTOCOLO PERTENCE A ESTE XML
      // SE DATA DO RECIBO MENOR QUE A DATA DE EMISSÃO O PROTOCOLO
      // PERTENCE A UM OUTRO XML JÁ VALIDADO  !;

      if (trunc(FdadosConsulta.data) < trunc(FACBrNFe.NotasFiscais[0]
        .nfe.Ide.dEmi)) and (FxmlOriginal <> '') then
      begin
        mydebug('  [CONSULTA PREVALIDA][FILIAL]:' + Fcd_filial +
          ' CUPON JA VALIDADO NA SEFAZ  DATA DE RECIBO ' +
          datetimetostr(trunc(FdadosConsulta.data))

          + ' MENOR QUE DATA DA NOTA ' +

          datetimetostr(trunc(FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi)));
        result := false;

        FACBrNFe.NotasFiscais.Clear;
        FACBrNFe.NotasFiscais.LoadFromString(UTF8Encode(FxmlOriginal));

      End
      else
      begin

        mydebug(' [CONSULTA PREVALIDA][FILIAL]:' + Fcd_filial +
          ' CUPON JA VALIDADO NA SEFAZ ');
        FAutorizado := true;

        if FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.nProt = '' then
        begin
          novachave := FdadosConsulta.chave;
          ocdNf := Copy(novachave, 36, 8);
          tpEmiss := strtoint(Copy(novachave, 35, 1));
          FACBrNFe.NotasFiscais[0].nfe.Ide.cNF := strtoint(ocdNf);

          if tpEmiss = 1 then
            FACBrNFe.NotasFiscais[0].nfe.Ide.tpEmis := teNormal
          else
            FACBrNFe.NotasFiscais[0].nfe.Ide.tpEmis := teOffLine;

          FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.nProt :=
            FdadosConsulta.nProt;
          FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.cstat :=
            FdadosConsulta.cstat;
          FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.chNFe :=
            FdadosConsulta.chave;
          FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.digVal :=
            FdadosConsulta.digito;
          FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.dhRecbto :=
            FdadosConsulta.data;

          checarTagsProtocolo(FACBrNFe);
          try
            FACBrNFe.NotasFiscais.GerarNFe;
          except

          end;
        End;
        result := true;
      end;
    end;
  except
    on e: EXCEPTION do
      mydebug('[675] ERRO CONSULTA JA VALIDADO - CNPJ [ ' +
        FACBrNFe.NotasFiscais.Items[0].nfe.Emit.CNPJCPF + ' ] ' + ' CUPON : ' +
        inttostr(FACBrNFe.NotasFiscais.Items[0].nfe.Ide.nNF) + '  - ' +
        e.Message)
  End;
end;

