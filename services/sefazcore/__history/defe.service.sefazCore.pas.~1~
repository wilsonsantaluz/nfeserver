{ ----------------------------------------------------------------------------- }
procedure TSefazCore.validarCfop(var FACBrNFe: TACBrNFe);
var
  ax: Integer;
begin
  for ax := 0 to FACBrNFe.NotasFiscais[0].nfe.Det.Count - 1 do
  begin
    if FACBrNFe.NotasFiscais[0].nfe.Det[ax].Prod.CFOP = '5403' then
      FACBrNFe.NotasFiscais[0].nfe.Det[ax].Prod.CFOP := '5405';
  end;
end;

{ ----------------------------------------------------------------------------- }
procedure TSefazCore.trataDuplicadade(var FACBrNFe: TACBrNFe; Astatus: String);
var
  cstat: Integer;
  verAplic: String;
  chNFe: string;
  nProt: string;
  srecibo: String;
  digVal: string;
  xmotivo: string;
  versao: string;
  dhRecbto: tdatetime;
  novachave: AnsiString;
  ACBrNFe1: TACBrNFe;
  procedure setXmlProtocoloDist;
  begin
    IF nProt <> '' Then
    begin
      FACBrNFe.NotasFiscais[0].nfe.infNFe.ID := 'NFe' + chNFe;
      if Copy(chNFe, 35, 1) = '1' then
      begin
        FACBrNFe.NotasFiscais[0].nfe.Ide.tpEmis := teNormal;
        FACBrNFe.NotasFiscais[0].nfe.Ide.xJust := '';
        FACBrNFe.NotasFiscais[0].nfe.Ide.dhCont := 0;
      end;

      FACBrNFe.NotasFiscais[0].nfe.procNFe.cstat := cstat;
      FACBrNFe.NotasFiscais[0].nfe.procNFe.verAplic := verAplic;
      FACBrNFe.NotasFiscais[0].nfe.procNFe.chNFe := chNFe;
      FACBrNFe.NotasFiscais[0].nfe.procNFe.dhRecbto := dhRecbto;
      FACBrNFe.NotasFiscais[0].nfe.procNFe.nProt := nProt;
      FACBrNFe.NotasFiscais[0].nfe.procNFe.digVal := digVal;
      FACBrNFe.NotasFiscais[0].nfe.procNFe.xmotivo := xmotivo;
      FACBrNFe.NotasFiscais[0].nfe.signature.DigestValue := digVal;
      sMsg := xmotivo;
      FACBrNFe.NotasFiscais[0].nfe.procNFe.versao := versao;
      checarTagsProtocolo(FACBrNFe);
    end
    else
      mydebug('     > >PROTOCOLO NÃO ENCONTRADO NA CONSULTA ');

  end;
  procedure setprotocoloConsulta;
  begin
    try
      if assigned(ACBrNFe1) then
      begin
        cstat := ACBrNFe1.WebServices.Consulta.protNFe.cstat;
        verAplic := ACBrNFe1.WebServices.Consulta.protNFe.verAplic;
        chNFe := ACBrNFe1.WebServices.Consulta.protNFe.chNFe;
        dhRecbto := ACBrNFe1.WebServices.Consulta.protNFe.dhRecbto;
        nProt := ACBrNFe1.WebServices.Consulta.protNFe.nProt;
        digVal := ACBrNFe1.WebServices.Consulta.protNFe.digVal;
        xmotivo := ACBrNFe1.WebServices.Consulta.protNFe.xmotivo;
        versao := ACBrNFe1.WebServices.Consulta.protNFe.versao;
      end
      else
      begin
        cstat := FACBrNFe.WebServices.Consulta.protNFe.cstat;
        verAplic := FACBrNFe.WebServices.Consulta.protNFe.verAplic;
        chNFe := FACBrNFe.WebServices.Consulta.protNFe.chNFe;
        dhRecbto := FACBrNFe.WebServices.Consulta.protNFe.dhRecbto;
        nProt := FACBrNFe.WebServices.Consulta.protNFe.nProt;
        digVal := FACBrNFe.WebServices.Consulta.protNFe.digVal;
        xmotivo := FACBrNFe.WebServices.Consulta.protNFe.xmotivo;
        versao := FACBrNFe.WebServices.Consulta.protNFe.versao;
      end;
      setXmlProtocoloDist();
    except
    end;
  end;
  procedure setprotocoloRecibo;
  begin
    if assigned(FACBrNFe.WebServices.Recibo.NFeRetorno.ProtDFe[0]) then
    begin
      cstat := FACBrNFe.WebServices.Recibo.NFeRetorno.ProtDFe[0].cstat;
      verAplic := FACBrNFe.WebServices.Recibo.verAplic;
      chNFe := FACBrNFe.WebServices.Recibo.NFeRetorno.ProtDFe[0].chDFe;
      dhRecbto := FACBrNFe.WebServices.Recibo.NFeRetorno.ProtDFe[0].dhRecbto;
      nProt := FACBrNFe.WebServices.Recibo.NFeRetorno.ProtDFe[0].nProt;
      digVal := FACBrNFe.WebServices.Recibo.NFeRetorno.ProtDFe[0].digVal;
      xmotivo := FACBrNFe.WebServices.Recibo.NFeRetorno.ProtDFe[0].xmotivo;
      versao := FACBrNFe.WebServices.Recibo.NFeRetorno.ProtDFe[0].verAplic;
      setXmlProtocoloDist();
    end;
  end;

  function GetRecibo: String;
  begin
    result := '';
    if Pos('[nRec:', Astatus) > 0 then
    begin
      result := Copy(Astatus, Pos('[nRec:', Astatus) + 6, Length(Astatus));
      result := Copy(result, 0, Pos(']', result) - 1);
    end;
  end;
  procedure checkCancelada;
  begin
    try
      if (FACBrNFe.WebServices.Consulta.procEventoNFe.Count > 0) and
        (FACBrNFe.WebServices.Consulta.procEventoNFe[0]
        .RetEventoNFe.retEvento.Count > 0) then
      begin

        with FACBrNFe.WebServices.Consulta.procEventoNFe[0]
          .RetEventoNFe.retEvento[0].RetInfEvento do
        begin
          nfceCancelada := TpEventoToStr(tpEvento) = '110111';
          FdadosConsulta.nProt := nProt;
          FdadosConsulta.chave := chNFe;
          FdadosConsulta.versao := verAplic;
          FdadosConsulta.data := dhRegEvento;
          FdadosConsulta.xmotivo := xmotivo;
          FdadosConsulta.cstat := cstat;
          FdadosConsulta.xml := xml;
          if nfceCancelada then
            mydebug('    [DUP] A NFCE ESTA CANCELADA PROTOCOLO  ' + nProt);
        end;
      end;
    except
    end;
  end;
  procedure checarChaveCorretaMsg();
  begin
    FchaveAutorizada := '';
    if (Pos(uppercase('chNFe'), uppercase(sMsg)) > 0) then
    begin
      FchaveAutorizada := Sonumeros(Copy(sMsg, Pos('chNFe', sMsg) + 5, 50));
      mydebug('     [DUP968] TRATANDO CHAVE RETORNADA ' + FchaveAutorizada);
    end
    else
    begin
      if Length(Sonumeros(sMsg)) = 44 then
      begin
        mydebug('     [DUP973] CHAVE RETORNADA  ' + Sonumeros(sMsg));
        FchaveAutorizada := Sonumeros(sMsg);
      end;
    end;
    if FchaveAutorizada <> '' then
    begin
      mydebug('     [DUP968] TRATANDO CHAVE RETORNADA ' + FchaveAutorizada);
      if Length(FchaveAutorizada) > 44 then
        FchaveAutorizada := Copy(FchaveAutorizada, 0, 44);

      FACBrNFe.WebServices.Consulta.Clear;
      FACBrNFe.WebServices.Consulta.NFeChave := FchaveAutorizada;
      Try
        FACBrNFe.WebServices.Consulta.Executar;
        if FACBrNFe.WebServices.Consulta.msg <> '' then
        begin
          sMsg := FACBrNFe.WebServices.Consulta.msg;
          mydebug('     [DUP978]RETORNADA MENSAGEN CONSULTA CHAVE  ' + sMsg);
        end;
      except
        on e: EXCEPTION do
        begin
          sMsg := e.Message;
          mydebug('    [DUP982]  ERRO 353 TRATANDO DUP  ' + e.Message);
        end;
      End;
      Fautorizacao := FACBrNFe.WebServices.Consulta.protNFe.nProt;
      with TstringList.create do
      begin
        text := FACBrNFe.WebServices.Consulta.RetornoWS;
        SaveToFile(ExtractFilePath(GetModuleName(HInstance)) + 'RETUN_DUP');
        Free;
      end;
      mydebug('    [DUP988]  DATA DE RECIBO RETORNADO SEFAZ  ' +
        datetimetostr(FACBrNFe.WebServices.Consulta.protNFe.dhRecbto) +

        '  -  DATA NO CABECALHO ' + datetimetostr
        (FACBrNFe.WebServices.Consulta.dhRecbto));
    end
    else
      mydebug('    [DUP985] CAMPO DE CHAVE CORRETA NÃO PODE SER LOCALIZADA NA MENSAGEM DA SEFAZ !');
  end;

begin

  Try
    Fautorizacao := '';
    If Length(FchaveAutorizada) > 40 Then
    begin
      FACBrNFe.WebServices.Consulta.Clear;
      FACBrNFe.WebServices.Consulta.NFeChave := FchaveAutorizada;
      Try
        FACBrNFe.WebServices.Consulta.Executar;
        if FACBrNFe.WebServices.Consulta.msg <> '' then
          sMsg := FACBrNFe.WebServices.Consulta.msg
      except
        on e: EXCEPTION do
        begin
          sMsg := e.Message;
          mydebug('    [DUP]  ERRO 353 TRATANDO DUP  ' + e.Message);
        end;
      End;
      mydebug('     [DUP981] RESULTADO CONSULTA DUP ' + sMsg);
      checkCancelada;
      Fautorizacao := '';
      Fautorizacao := FACBrNFe.WebServices.Consulta.protNFe.nProt;
      if Fautorizacao = '' then
        checarChaveCorretaMsg();
      mydebug('     [DUP]1014 PROTOCOLO  AUTORIZACAO RETORNNADO ' +
        Fautorizacao);
      Fautorizacao := FACBrNFe.WebServices.Consulta.protNFe.nProt;
      ValidarDataRecibo(FACBrNFe,
        FACBrNFe.WebServices.Consulta.protNFe.dhRecbto);
    end;
    mydebug('     [DUP1012] TENTANDO VALIDAR SE EMITIDA EM MODO NORMAL ' +
      sMsg);
    if Fautorizacao = '' then
    Begin
      novachave := GerarChaveAcesso(FACBrNFe.NotasFiscais[0].nfe.Ide.cUF,
        FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi,
        FACBrNFe.NotasFiscais[0].nfe.Emit.CNPJCPF,
        FACBrNFe.NotasFiscais[0].nfe.Ide.serie,
        FACBrNFe.NotasFiscais[0].nfe.Ide.nNF, 1,
        FACBrNFe.NotasFiscais[0].nfe.Ide.cNF, 65

        );
      // *******----------------------------------------------------------------

      ACBrNFe1 := TACBrNFe.create(Nil);

      ACBrNFe1.Configuracoes.Geral.ModeloDF := moNFCe;
      ACBrNFe1.Configuracoes.WebServices.UF :=
        CodigoParaUF(strtoint(Copy(novachave, 0, 2)));

      ACBrNFe1.Configuracoes.Geral.VersaoDF := ve400;
      ACBrNFe1.Configuracoes.WebServices.Ambiente := taProducao;
      TAcbrConfig.SetAcbrObj(ACBrNFe1,
        FACBrNFe.NotasFiscais[0].nfe.Emit.CNPJCPF);
      ACBrNFe1.NotasFiscais.Clear;
      ACBrNFe1.WebServices.Consulta.NFeChave := novachave;

      // *******---------------------------------------------------------------

      Try
        ACBrNFe1.WebServices.Consulta.Executar;
        if ACBrNFe1.WebServices.Consulta.msg <> '' then
          sMsg := ACBrNFe1.WebServices.Consulta.msg
      except
        on e: EXCEPTION do
        begin
          sMsg := e.Message;
          mydebug('    [DUP1052]  ERRO 353 TRATANDO DUP  ' + e.Message);
        end;
      End;
      checkCancelada;
      mydebug('     [DUP1056] RESULTADO CONSULTA DUP ' + sMsg);
      Fautorizacao := '';
      Fautorizacao := ACBrNFe1.WebServices.Consulta.protNFe.nProt;
      if Fautorizacao = '' then
      Begin
        checarChaveCorretaMsg();
        ValidarDataRecibo(FACBrNFe,
          FACBrNFe.WebServices.Consulta.protNFe.dhRecbto);
      end
      else
        ValidarDataRecibo(FACBrNFe,
          ACBrNFe1.WebServices.Consulta.protNFe.dhRecbto);
      if Fautorizacao <> '' then
      begin
        setprotocoloConsulta;
        FACBrNFe.NotasFiscais[0].nfe.Ide.tpEmis := teNormal;
        FACBrNFe.NotasFiscais[0].nfe.Ide.xJust := '';
        FACBrNFe.NotasFiscais[0].nfe.Ide.dhCont := 0;

        try
          FACBrNFe.NotasFiscais[0].nfe.signature.Clear;
        except
        end;
        try
          FACBrNFe.NotasFiscais[0].GerarXML;
        except
        end;
        try
          FACBrNFe.NotasFiscais[0].Assinar;
        except
        end;
      end;
    end;
    if assigned(ACBrNFe1) then
      FreeAndNil(ACBrNFe1);
    if Fautorizacao <> '' then
    begin
      mydebug('    [DUP] ' + Fcd_filial + ' SUCESSO CORRIGINDO DUPLICIDADE');

      FACBrNFe.NotasFiscais[0].nfe.infNFeSupl.qrCode := '';
      FACBrNFe.NotasFiscais[0].nfe.signature.Clear;
      setprotocoloConsulta;
      FxmlProcessado := FACBrNFe.NotasFiscais[0].GerarXML;
      try
        FACBrNFe.NotasFiscais.Assinar;
      except

      end;
      FAutorizado := true;
    end
    else
    begin
      try
        srecibo := GetRecibo;
        if srecibo = '' then
          srecibo := FchaveAutorizada;
        if srecibo <> '' then
        begin
          FACBrNFe.WebServices.Recibo.Recibo := srecibo;;
          FACBrNFe.WebServices.Recibo.Executar;
          Fautorizacao := FACBrNFe.WebServices.Recibo.NFeRetorno.
            ProtDFe[0].nProt;

          FACBrNFe.NotasFiscais[0].nfe.infNFeSupl.qrCode := '';
          FACBrNFe.NotasFiscais[0].nfe.signature.Clear;
          setprotocoloConsulta;
          FxmlProcessado := FACBrNFe.NotasFiscais[0].GerarXML;
          try
            FACBrNFe.NotasFiscais.Assinar;
          except

          end;
          mydebug('    [DUP]QRCODE ' + FACBrNFe.NotasFiscais[0]
            .nfe.infNFeSupl.qrCode);
          checkCancelada();
          ValidarDataRecibo(FACBrNFe, FACBrNFe.WebServices.Consulta.dhRecbto);
          if (Fautorizacao <> '') then
          begin
            setprotocoloRecibo;
            FxmlProcessado := FACBrNFe.NotasFiscais[0].GerarXML;
            FAutorizado := true;
          end;
        end;
      except
      end;

      if not validaxmlvenda(FACBrNFe) then
      begin
        FACBrNFe.NotasFiscais[0].nfe.procNFe.dhRecbto := 0;
        FACBrNFe.NotasFiscais[0].nfe.procNFe.chNFe := '';
        FACBrNFe.NotasFiscais[0].nfe.procNFe.nProt := '';
        FACBrNFe.NotasFiscais[0].nfe.procNFe.cstat := 0;
        FACBrNFe.NotasFiscais[0].nfe.procNFe.digVal := '';
        FxmlProcessado := FACBrNFe.NotasFiscais[0].GerarXML;
      end;

    end;
  except
    on e: EXCEPTION do
    begin
      mydebug(' ---->FILIAL' + Fcd_filial + ' ERRO ' + e.Message);
      sMsg := e.Message;
    end;
  end;
end;


{ -+--------------------------------------------------------------------------- }
Procedure TSefazCore.validarDadosContigencia(var FACBrNFe: TACBrNFe);
var
  aData: tdatetime;
begin

  // VERIFICAR SE A HORA ESTA ZERADA  -ALGUNS ESTADOS COMO MT NÃO ACEITAN
  if (HourOf(FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi) = 0) then
  begin

    FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi :=
      EncodeDateTime(YearOf(FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi),
      MonthOf(FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi),
      DayOf(FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi), HourOf(now), 0, 0, 0

      );

  end;
  // VALIDAR HORA MAIOR QUE DATA ACTUAL CASO OFFLINE
  if (FACBrNFe.NotasFiscais[0].nfe.Ide.tpEmis = teOffLine) then
  begin
    if FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi > now then
      FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi := now;
    FACBrNFe.NotasFiscais[0].nfe.Ide.dhCont := FACBrNFe.NotasFiscais[0]
      .nfe.Ide.dEmi;

    if (Length(FACBrNFe.NotasFiscais[0].nfe.Ide.xJust) < 30) and
      (FACBrNFe.NotasFiscais[0].nfe.Ide.tpEmis = teOffLine) Then
    begin
      FACBrNFe.NotasFiscais[0].nfe.Ide.xJust := 'PROBLEMAS TECNICOS.'
    end;

    if (Length(FACBrNFe.NotasFiscais[0].nfe.Ide.xJust) > 256) and
      (FACBrNFe.NotasFiscais[0].nfe.Ide.tpEmis = teOffLine) Then
    begin
      FACBrNFe.NotasFiscais[0].nfe.Ide.xJust := 'PROBLEMAS TECNICOS.'
    end;
  end;

  // VERIFICAR SE DATA ANTERIOR A 2013
  if FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi < EncodeDate(2013, 01, 01) then
  begin
    gravalog('DATA DE EMISSAO ANTERIOR A 2013');
    FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi := date - 1;
    FACBrNFe.NotasFiscais[0].nfe.Ide.dhCont := date - 1;
  end;
  // VERIFICAR SE E VIRADA DE MES
  aData := FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi;
  if (strtoint(FormatDateTime('dd', aData)) = 1) and
    (strtoint(FormatDateTime('hh', aData)) < 3) then
  Begin
    FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi :=
      IncHour(FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi, 3);

    mydebug('[SEFAZCORE]FILIAL:' + Fcd_filial + ' CUPON : ' + Fnr_nota +
      ' CUPOM EMITIDO COM DIFERENÇA DE HORARIO VERÃO');

  End;

  // VALIDAR CAMPO XFANT/XNOME QUANDO MAIOR QUE O PERMITIDO
  FACBrNFe.NotasFiscais[0].nfe.Emit.xFant :=
    Copy(FACBrNFe.NotasFiscais[0].nfe.Emit.xFant, 0, 48);
  FACBrNFe.NotasFiscais[0].nfe.Emit.xNome :=
    Copy(FACBrNFe.NotasFiscais[0].nfe.Emit.xNome, 0, 48);

  // VALIDAR
  if FACBrNFe.NotasFiscais[0].nfe.Ide.nNF = 0 then
    if FACBrNFe.NotasFiscais[0].nfe.Ide.cNF > 0 then
      FACBrNFe.NotasFiscais[0].nfe.Ide.nNF := FACBrNFe.NotasFiscais[0]
        .nfe.Ide.cNF
    else
      FACBrNFe.NotasFiscais[0].nfe.Ide.nNF := strtoint(Fnr_ecf);
end;

{ ----------------------------------------------------------------------------- }
procedure TSefazCore.validarRastro(var FACBrNFe: TACBrNFe);
var
  iIndex: Integer;
  irastro: Integer;
  odate: tdatetime;
begin
  for iIndex := 0 to FACBrNFe.NotasFiscais[0].nfe.Det.Count - 1 do
  begin
    for irastro := 0 to FACBrNFe.NotasFiscais[0].nfe.Det[iIndex]
      .Prod.rastro.Count - 1 do
    begin
      if FACBrNFe.NotasFiscais[0].nfe.Det[iIndex].Prod.rastro[irastro].dFab > date
      then
      begin
        odate := date;
        odate := IncDay(odate, -30);
        FACBrNFe.NotasFiscais[0].nfe.Det[iIndex].Prod.rastro[irastro]
          .dFab := odate;
      end;
      if FACBrNFe.NotasFiscais[0].nfe.Det[iIndex].Prod.rastro[irastro].dVal < date
      then
      begin
        odate := date;
        odate := IncDay(odate, +30);
        FACBrNFe.NotasFiscais[0].nfe.Det[iIndex].Prod.rastro[irastro]
          .dVal := odate;
      end;

    end;
  end;

end;


{ ------------------------------------------------------------------------------ }

procedure TSefazCore.validarDestinatario(var FACBrNFe: TACBrNFe);
begin
  if FACBrNFe.NotasFiscais[0].nfe.dest.CNPJCPF = FACBrNFe.NotasFiscais[0]
    .nfe.Emit.CNPJCPF then
  begin
    FACBrNFe.NotasFiscais[0].nfe.dest.CNPJCPF := '';
  end;
  if FACBrNFe.NotasFiscais[0].nfe.dest.EnderDest.cMun = 0 then
  begin
    FACBrNFe.NotasFiscais[0].nfe.dest.EnderDest.cMun := FACBrNFe.NotasFiscais[0]
      .nfe.Emit.EnderEmit.cMun;
  end;
  if FACBrNFe.NotasFiscais[0].nfe.Emit.CNPJCPF = '' then
  begin
    FACBrNFe.NotasFiscais[0].nfe.Emit.CNPJCPF :=
      Copy(Sonumeros(FACBrNFe.NotasFiscais[0].nfe.infNFe.ID), 7, 14);
  end;
  if StrToFloat(Sonumeros(FACBrNFe.NotasFiscais[0].nfe.Emit.CNPJCPF)) < 1 then
  begin
    FACBrNFe.NotasFiscais[0].nfe.Emit.CNPJCPF := FCnpjFilial;
  end;
  if (Length(FACBrNFe.NotasFiscais[0].nfe.dest.EnderDest.xBairro) > 0) and
    (Length(FACBrNFe.NotasFiscais[0].nfe.dest.EnderDest.xBairro) < 6) then
  begin

    FACBrNFe.NotasFiscais[0].nfe.dest.EnderDest.xBairro := 'NÃO INFORMADO';

  end;
  if (FACBrNFe.NotasFiscais[0].nfe.dest.EnderDest.CEP > 0) then
  begin
    if Length(FACBrNFe.NotasFiscais[0].nfe.dest.EnderDest.xLgr) < 5 then
      FACBrNFe.NotasFiscais[0].nfe.dest.EnderDest.xLgr := 'NÃO INFORMADO';

    if FACBrNFe.NotasFiscais[0].nfe.dest.EnderDest.xBairro = '' then
      FACBrNFe.NotasFiscais[0].nfe.dest.EnderDest.xBairro := 'NÃO INFORMADO';

  end;

end;

{ ----------------------------------------------------------------------------- }
procedure TSefazCore.enviarNota(var FACBrNFe: TACBrNFe);

begin
  VInicio := Time;
  TAcbrConfig.SetAcbrObj(FACBrNFe, FACBrNFe.NotasFiscais[0].nfe.Emit.CNPJCPF);
  if FACBrNFe.NotasFiscais[0].nfe.Ide.tpAmb = taProducao then
  begin
    FACBrNFe.Configuracoes.WebServices.Ambiente := taProducao;
  end
  else
  begin
    FACBrNFe.Configuracoes.WebServices.Ambiente := taHomologacao;
    FACBrNFe.NotasFiscais[0].nfe.infNFeSupl.qrCode := '';
  end;
  FACBrNFe.Configuracoes.WebServices.UF :=
    CodigoParaUF(FACBrNFe.NotasFiscais[0].nfe.Ide.cUF);
  FACBrNFe.Configuracoes.Geral.VersaoDF := ve400;
  if DebugHook > 0 then
  begin
    /// WILSON PARA TESTES  SO UTILIZAR AMBIENTE DE HOMOLOGAÇÃO
    // FACBrNFe.Configuracoes.WebServices.Ambiente := taHomologacao;
  end;
  Try
    try
      FACBrNFe.NotasFiscais[0].nfe.signature.Clear;

      FxmlProcessado := FACBrNFe.NotasFiscais[0].GerarXML;
    except
    end;
    try
      FACBrNFe.NotasFiscais[0].Assinar;

    except
    end;
    try
      FACBrNFe.NotasFiscais[0].Validar;
    except
    end;
    if FACBrNFe.NotasFiscais[0].nfe.Ide.serie = 0 then
      raise EXCEPTION.create('Serie invalida informada  -> 0 ');
    try
      FACBrNFe.WebServices.Envia(1, true);
    except
      on e: EXCEPTION do
      begin
        // ACBR  LANÇA MENSGEM VAZIA
        if e.Message <> '' then
        begin
          mydebug('[ENV-NFCE1541]: ' + Fcd_filial + ' - CNPJ: ' +
            FACBrNFe.NotasFiscais[0].nfe.Emit.CNPJCPF + '  - ' + 'ID_CSS: ' +
            FACBrNFe.Configuracoes.Geral.IdCSC + ' -' + 'CSS: ' +
            FACBrNFe.Configuracoes.Geral.CSC + ' CHAVE : ' +
            FACBrNFe.NotasFiscais[0].nfe.infNFe.ID + '  ' +
            Copy(e.Message, 0, 50));
          FcStat := 5001;
          // ENVIO NÃO REALIZADO
          Ferro := e.Message;
          sMsg := Ferro;
          with TstringList.create do
          begin
            text := FACBrNFe.NotasFiscais[0].xml;
            ForceDirectories(ExtractFilePath(GetModuleName(HInstance)) +
              '\XML_ERROR\');
            SaveToFile(ExtractFilePath(GetModuleName(HInstance)) + '\XML_ERROR\'
              + FACBrNFe.NotasFiscais[0].nfe.infNFe.ID + '.XML');
            Free;
          end;
        end;
      end;
    end;

  except
    on e: EXCEPTION do
    begin
      sMsg := e.Message;
      mensagemErro := e.Message;
      Ferro := '[ENVIO] ' + e.Message;
      sMsg := Ferro;
      mydebug('[E874]EXCESSAO  --> ' + sMsg);
    end;
  end;
  Fautorizacao := FACBrNFe.NotasFiscais.Items[0].nfe.procNFe.nProt;
  Fstatus := FACBrNFe.WebServices.Retorno.msg;
  if Fstatus = '' then
    Fstatus := FACBrNFe.WebServices.Enviar.msg;
  if Fstatus = '' then
    Fstatus := sMsg;
  FcStat := FACBrNFe.WebServices.Retorno.cstat;
  if FcStat = 0 then
    FcStat := FACBrNFe.WebServices.Enviar.cstat;
  if FcStat = 0 then
  begin
    FcStat := 7001;
    sMsg := Ferro;
  end;
  if sMsg <> '' then
    mensagemErro := sMsg;
  if FACBrNFe.WebServices.Retorno.xmotivo <> '' then
  begin
    mensagemErro := FACBrNFe.WebServices.Retorno.xmotivo;
  end;
  setIndicadores;
  if Fautorizacao <> '' then
  begin
    FxmlProcessado := FACBrNFe.NotasFiscais[0].GerarXML;
    FAutorizado := true;
    FTdataLocal.FIndicadores.NfcesValidadas :=
      FTdataLocal.FIndicadores.NfcesValidadas + 1;
  end
  else
  begin
    FACBrNFe.NotasFiscais[0].GerarXML;
  end;
end;

