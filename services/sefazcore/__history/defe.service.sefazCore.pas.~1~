procedure TSefazCore.ValidarDataRecibo(var FACBrNFe: TACBrNFe;
  pdatarecibo: tdatetime);

var
  aData: tdatetime;
begin

  // SE FOR  SÃO PAULO  TEM QUE PEGAR A DATA DA VENDA
  // POR QUE A DATA DE EMISSÃO DO XML JA FOI ALTERADA.
  mydebug('[SEFAZCORE]1536 VALIDANDO DATA DA VENDA INFORMADA ->  ' + Fdt_vd);

  aData := FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi;
  try
    if (Fdt_vd <> '') then
      trystrtodate(Fdt_vd, aData);
  except
  end;
  if (FACBrNFe.NotasFiscais[0].nfe.Ide.cUF = 35) and (Fdt_vd <> '') then
    trystrtodate(Fdt_vd, aData);
  if aData = 0 then
  begin
    FAutorizado := false;
    mydebug('[SEFAZCORE]1529 FILIAL:' + Fcd_filial + ' CUPON : ' + Fnr_nota +
      ' DATA DE EMISSAO NÃO DETERMINADA');
    exit;
  end;
  if ((trunc(aData)) <= trunc(pdatarecibo)) or (FignorarDataRecibo) then
  begin

    mydebug('[SEFAZCORE]1529 FILIAL:' + Fcd_filial + ' CUPON : ' + Fnr_nota +
      ' NOTA COM DUPLICIDADE CORRIGIDA');
    FxmlProcessado := FACBrNFe.NotasFiscais[0].xml;
    FAutorizado := true;

    if assigned(FTdataLocal) then
    begin
      FTdataLocal.FIndicadores.NfcesValidadas :=
        FTdataLocal.FIndicadores.NfcesValidadas + 1;
    end;
  end
  else
  begin
    mydebug('[SEFAZCORE 1542]FILIAL:' + Fcd_filial + ' CUPON : ' + Fnr_nota +
      ' NOTA COM DUPLICIDADE E RECIBO  ' + datetimetostr(trunc(pdatarecibo)) +

      ' COM DATA ANTERIOR A EMISSAO ' + datetimetostr(aData));
    FAutorizado := false;
    Fautorizacao := '';

    FACBrNFe.NotasFiscais.Clear;
    FACBrNFe.NotasFiscais.LoadFromString(UTF8Encode(FxmlOriginal));

  end;

end;

