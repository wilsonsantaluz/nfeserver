{ ------------------------------------------------------------------------------ }
procedure TSefazCore.ValidarXml(var FACBrNFe: TACBrNFe);
var
  nr_nota: string;
  osdate: string;
begin
  LimparVariaveis;
  FAutorizado := false;
  FcStat := 2001;
  try
    validarPagamentos(FACBrNFe);
    FxmlOriginal := FACBrNFe.NotasFiscais[0].xml;
    FchaveOriginal := Sonumeros(FACBrNFe.NotasFiscais[0].nfe.infNFe.ID);
    nr_nota := inttostr(FACBrNFe.NotasFiscais[0].nfe.Ide.nNF);
    Fnr_nota := nr_nota;
    TAcbrConfig.SetAcbrObj(FACBrNFe, FACBrNFe.NotasFiscais[0].nfe.Emit.CNPJCPF);
    IF (FACBrNFe.NotasFiscais[0].nfe.infNFe.versao <> 4) then
    begin
      FACBrNFe.NotasFiscais[0].nfe.infNFe.versao := 4.0;
      FACBrNFe.Configuracoes.Geral.VersaoDF := ve400;
      regerarXMLnota(FACBrNFe);

    end;
    if FverificarJaValidado then
    begin

      if cuponJaValidado(FACBrNFe) then
      begin
        mydebug('[904] CUPON JÁ VALIDADO - CNPJ [ ' +
          FACBrNFe.NotasFiscais.Items[0].nfe.Emit.CNPJCPF + ' ] ' + ' CUPON : '
          + inttostr(FACBrNFe.NotasFiscais.Items[0].nfe.Ide.nNF));

        exit;
      end;
    end;
    // CODIGOS IMPLEMENTANDOS PARA CORRIGIR EMERGENCIAS
    // RETIRAR QUANDO.....
    corrigirCodigoNumerico(FACBrNFe);

    validarCfop(FACBrNFe);
    validaGtin(FACBrNFe);
    validarCbnef(FACBrNFe);
    validarDestinatario(FACBrNFe);

    if (FtipoOperacao = 3) or (FtipoOperacao = 7) then

    begin
      TAcbrConfig.calcularNFCE(FACBrNFe);
    end;
    validarIcms(FACBrNFe);

    osdate := datetimetostr(FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi);
    validarDadosContigencia(FACBrNFe);
    validarPaisUf51(FACBrNFe);
    validarUFDest(FACBrNFe);
    validarNcm(FACBrNFe);
    validarBc(FACBrNFe);
    validarRastro(FACBrNFe);
    validarTipoEmissaoSp(FACBrNFe);
    validarPagamentos(FACBrNFe);
    /// RESPONSAVEL TECNICO//
    try
      if (FACBrNFe.NotasFiscais[0].nfe.infRespTec.cnpj <> '') and
        (Length(FACBrNFe.NotasFiscais[0].nfe.infRespTec.cnpj) < 10) then
        FACBrNFe.NotasFiscais[0].nfe.infRespTec.cnpj := '';
      if (FACBrNFe.NotasFiscais[0].nfe.infRespTec.cnpj = '') and
        (Sonumeros(FTrespTecnico.cnpj) <> '') then
      begin
        try
          FACBrNFe.NotasFiscais[0].nfe.infRespTec.cnpj :=
            Sonumeros(FTrespTecnico.cnpj);
          FACBrNFe.NotasFiscais[0].nfe.infRespTec.xContato :=
            FTrespTecnico.Contato;
          FACBrNFe.NotasFiscais[0].nfe.infRespTec.email := FTrespTecnico.email;
          FACBrNFe.NotasFiscais[0].nfe.infRespTec.fone :=
            Sonumeros(FTrespTecnico.fone);
        except
          on e: EXCEPTION do
          begin
            gravalog('[SEFAZ CORE] 1720 ERRO RESPTECNICO ' + e.Message);
          end;
        end;
      end;
    except
      on e: EXCEPTION do
        gravalog('[SEFAZ CORE] 1725 ERRO RESPTECNICO ' + e.Message);
    end;
    // CPF/CNPJ ZERADO
    if (Sonumeros(FACBrNFe.NotasFiscais[0].nfe.dest.CNPJCPF) <> '') and
      (StrToFloat(Sonumeros(FACBrNFe.NotasFiscais[0].nfe.dest.CNPJCPF)) < 10)
    then
      FACBrNFe.NotasFiscais[0].nfe.dest.CNPJCPF := '';

    Fautorizacao := '';
    osdate := datetimetostr(FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi);
    regerarXMLnota(FACBrNFe);

    osdate := datetimetostr(FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi);
    FcStat := 0;
    sMsg := '';
    Fstatus := '';
    VInicio := Time;
    try
      enviarNota(FACBrNFe);
    except
      on e: EXCEPTION do
      begin
        if Pos(uppercase('ccess violation'), e.Message) > 0 then
        begin
          FatalError := true;

        end;

        gravalog('[SEFAZ CORE] 590 ERRO ENVIO DA NOTA  ' + e.Message);
        mensagemErro := e.Message;
        Fmotivo := e.Message;

      end;
    end;
    // ***********************************************************************
    if (FcStat <> 5001) and (Fautorizacao = '') and (assigned(FTdataLocal)) then
      FTdataLocal.FIndicadores.ErrosValidacao :=
        FTdataLocal.FIndicadores.ErrosValidacao + 1;

    // ************************************************************************
    if (FcStat = 5001) and (Fautorizacao = '') then
    begin
      if assigned(FTdataLocal) then
        FTdataLocal.FIndicadores.FalhasSefaz :=
          FTdataLocal.FIndicadores.FalhasSefaz + 1;
      sMsg := '[FILIAL]: ' + Fcd_filial + ' - NOTA ' + nr_nota + '[e - 5001] : '
        + nr_nota + ' ' + Fstatus;
      mydebug(sMsg);
      if mensagemErro = '' then
        mensagemErro := sMsg;
      codigoErro := FcStat;
      Sleep(500);
      exit;
    end;


    IF FcStat = 374 then
    begin
      mydebug('[ SEFAZ CORE1990 ] VALIDANDO ERRO 374 ');
      validarGrupoTributacao(FACBrNFe);
      enviarNota(FACBrNFe);
    end;
    IF (FcStat = 704) or (FcStat = 556) then
    begin
      mydebug('[ SEFAZ CORE1990 ] VALIDANDO ERRO 704 ');
      FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi := now;
      FACBrNFe.NotasFiscais[0].nfe.Ide.dSaiEnt := now;
      try
        FACBrNFe.NotasFiscais[0].GerarXML;
      except
      end;
      enviarNota(FACBrNFe);
    end;
    if FcStat = 656 then
    begin
      mydebug('[FILIAL] : ' + Fcd_filial + ' - NOTA ' + nr_nota +
        '  [E-656] CONSUMO INDEVIDO  VALIDAÇÃO ABORTADA ' + Fstatus);
      FAutorizado := false;
      Fstatus := sMsg;
      mensagemErro := mensagemErro + ' - ' + sMsg;
      codigoErro := FcStat;
      raise EXCEPTION.create(sMsg);
    end;
    if not FAutorizado then
    begin

      if FcStat = 531 then
      begin
        mydebug('[ SEFAZ CORE ] RECALCULANDO BASE DE CALCULO');
        validarBc(FACBrNFe);
        enviarNota(FACBrNFe);
      end;
      if (FcStat = 539) then
      begin
        if Fstatus = '' then
          Fstatus := sMsg;
        sMsg := '539 - ' + FchaveOriginal + ' - ' + Fstatus;
        if Fstatus = '' then
          Fstatus := sMsg;
        FAutorizado := false;
        mensagemErro := mensagemErro + ' - ' + sMsg;
        codigoErro := FcStat;
        mydebug(sMsg);
        FchaveAutorizada := '';
        if Pos('[', Fstatus) > 1 then
        begin
          FchaveAutorizada := Copy(Fstatus, Pos('[', Fstatus) + 1,
            Length(Fstatus));
          FchaveAutorizada := Copy(FchaveAutorizada, 0,
            Pos(']', FchaveAutorizada) - 1);
          FchaveAutorizada := Sonumeros(FchaveAutorizada);
          if testaChave(FchaveOriginal, FchaveAutorizada) then
            trataDuplicadade(FACBrNFe, Fstatus);
        end;

        if not FAutorizado then
        begin
          trataDuplicadade(FACBrNFe, '');
        end;
        ValidarProtocolo(FACBrNFe);

      end
      else if (FcStat = 204) then
      begin
        Ferro := Copy(Fstatus, 0, 300);
        FAutorizado := false;
        Fautorizacao := '';
        try
          mydebug('[SEFAZCORE]FILIAL: ' + Fcd_filial + ' NOTA : ' + nr_nota +
            ' TRATANDO DUPLICIDADE 204');
          FACBrNFe.NotasFiscais.Clear;
          FACBrNFe.NotasFiscais.LoadFromString(UTF8Encode(FxmlOriginal));
          VInicio := Time;
          FACBrNFe.Consultar;
          mydebug('[SEFAZCORE] FILIAL: ' + Fcd_filial + ' NOTA : ' + nr_nota +
            ' RETORNO CONSULTA EM DUPLICIDADE ' +
            FACBrNFe.WebServices.Consulta.msg);

          setIndicadores();
          Fautorizacao := FACBrNFe.WebServices.Consulta.protNFe.nProt;
          if Fautorizacao <> '' then
          begin
            // TRATAR SE E O PROTOCOLO PERTENCE A ESTE XML
            // SE DATA DO RECIBO MENOR QUE A DATA DE EMISSÃO O PROTOCOLO
            // PERTENCE A UM OUTRO XML JÁ VALIDADO  !;

            ValidarDataRecibo(FACBrNFe, FACBrNFe.WebServices.Consulta.dhRecbto);
          end
          else
          Begin
            if FACBrNFe.WebServices.Consulta.cstat = 526 then
            begin
              if Pos('[', Fstatus) > 1 then
              begin
                FchaveAutorizada := Copy(Fstatus, Pos('[', Fstatus) + 1,
                  Length(Fstatus));
                FchaveAutorizada := Copy(FchaveAutorizada, 0,
                  Pos(']', FchaveAutorizada) - 1);
                FchaveAutorizada := Sonumeros(FchaveAutorizada);

              end;
              if FchaveAutorizada = '' then
                FchaveAutorizada := FormatDateTime('DDMMYYYhhmmsszz', now);
              FACBrNFe.NotasFiscais[0].nfe.procNFe.dhRecbto :=
                FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi;

              FACBrNFe.NotasFiscais[0].nfe.procNFe.chNFe :=
                Sonumeros(FACBrNFe.NotasFiscais[0].nfe.infNFe.ID);

              FACBrNFe.NotasFiscais[0].nfe.procNFe.nProt := FchaveAutorizada;
              FACBrNFe.NotasFiscais[0].nfe.procNFe.cstat := 204;

              FACBrNFe.NotasFiscais[0].nfe.procNFe.xmotivo :=
                'AUTORIZADO USO NFE';
              FxmlProcessado := FACBrNFe.NotasFiscais[0].GerarXML;
              FAutorizado := true;
            end;
            mydebug('[SEFAZCORE] FILIAL: ' + Fcd_filial + ' NOTA : ' + nr_nota +
              ' A CONSULTA DE DUPLICIDADE NÃO RETORNOU PROTOCOLO  -> ' +
              FACBrNFe.WebServices.Consulta.xmotivo);
          end;

          ValidarProtocolo(FACBrNFe);

        except
          on e: EXCEPTION do
          begin
            mydebug('[SEFAZCORE] [FILIAL]:' + Fcd_filial + ' NOTA : ' + nr_nota
              + ' ->  ' + e.Message);
            trataDuplicadade(FACBrNFe, Fstatus);
          end;
        end;
      end
      else
      begin
        if (FcStat <> 108) and (FcStat <> 109) and (FcStat > 0) then
        begin
          Ferro := Copy(Fstatus, 0, 150);
          FAutorizado := false;
        end;
      end;
    end;
    if FAutorizado then
    Begin

      FACBrNFe.NotasFiscais[0].GerarXML;
      mydebug('[SEFAZCORE]1825 PROTOCOLO GERADO ' + FACBrNFe.NotasFiscais[0]
        .nfe.procNFe.nProt);
    End;
  except
    on e: EXCEPTION do
    begin
      mydebug('[SEFAZCORE]E1079  [FILIAL]:' + Fcd_filial + e.Message);
      codigoErro := FcStat;
      mensagemErro := mensagemErro + ' - ' + e.Message;
      Fmotivo := e.Message;

    end;
  end;
  limparComponente(FACBrNFe);
end;

function TSefazCore.validaxmlvenda(var FACBrNFe: TACBrNFe): Boolean;
var
  dtProtocolo: tdatetime;
begin
  result := true;
  dtProtocolo := FACBrNFe.NotasFiscais[0].nfe.procNFe.dhRecbto;
  if dtProtocolo > 100 then
  begin
    if (trunc(dtProtocolo)) < (trunc(FACBrNFe.NotasFiscais[0].nfe.Ide.dEmi))
    then
    begin
      result := false;
      Ferro := '[E643]O XML NÃO PERTENCE A ESTE CUPOM PROVALVEMENTE DUPLICIDADE';
      gravalog(Ferro);

    end;
  End;
end;

end.
